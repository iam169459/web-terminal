[Unit]
Description=Headless Server Web UI
After=network.target

[Service]
Type=simple
User=%i
WorkingDirectory=/home/%i/Desktop/web-terminal
ExecStart=/home/%i/Desktop/web-terminal/.venv/bin/python -m app.main
# "always" so a self-update (which exits cleanly) is restarted too.
Restart=always
RestartSec=3

# Optional hardening - uncomment to tweak what the UI can touch.
# Environment=WEBUI_FILE_ROOT=/
# Environment=WEBUI_PORT=8080
# Environment=WEBUI_SYSTEMCTL_SUDO=1
# There is no login; only expose beyond localhost if you know what you are doing.
# Environment=WEBUI_HOST=0.0.0.0

[Install]
WantedBy=default.target
